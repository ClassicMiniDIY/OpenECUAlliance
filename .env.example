# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Rate limiting protects the API from abuse, scraping, and DoS attacks.
# Adjust these values based on your traffic patterns and server capacity.

# Enable/disable rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# List endpoints (/api/adapters, /api/protocols, /api/models)
# Default: 30 requests per minute, 300 per hour
RATE_LIMIT_LIST_PER_MINUTE=30
RATE_LIMIT_LIST_PER_HOUR=300

# Detail endpoints (/api/adapters/[vendor]/[id], /api/protocols/[vendor]/[id])
# Default: 60 requests per minute, 600 per hour
RATE_LIMIT_DETAIL_PER_MINUTE=60
RATE_LIMIT_DETAIL_PER_HOUR=600

# Raw download endpoints (/api/specs/.../raw)
# Default: 20 requests per minute, 150 per hour
RATE_LIMIT_DOWNLOAD_PER_MINUTE=20
RATE_LIMIT_DOWNLOAD_PER_HOUR=150

# Asset endpoints (/api/assets/*)
# Default: 100 requests per minute, 1000 per hour
RATE_LIMIT_ASSET_PER_MINUTE=100
RATE_LIMIT_ASSET_PER_HOUR=1000

# Model endpoints (/api/models, /api/models/*)
# Default: 40 requests per minute, 400 per hour
RATE_LIMIT_MODEL_PER_MINUTE=40
RATE_LIMIT_MODEL_PER_HOUR=400

# POST endpoints (submissions, uploads)
# Default: 10 requests per minute, 50 per hour
RATE_LIMIT_POST_PER_MINUTE=10
RATE_LIMIT_POST_PER_HOUR=50

# User profile endpoints (/api/users/[username])
# Default: 30 requests per minute, 300 per hour
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_USER_PER_HOUR=300

# Block duration after rate limit violation (in seconds)
# Default: 900 seconds (15 minutes)
RATE_LIMIT_BLOCK_DURATION=900

# IP whitelist (comma-separated list of IP addresses)
# Whitelisted IPs bypass rate limiting
# Example: 192.168.1.1,10.0.0.1
RATE_LIMIT_WHITELIST=

# =============================================================================
# Security Configuration
# =============================================================================

# Maximum request body size in bytes (default: 5242880 = 5MB)
SECURITY_MAX_REQUEST_SIZE=5242880

# Request timeout in milliseconds (default: 30000 = 30 seconds)
SECURITY_REQUEST_TIMEOUT=30000

# Trust proxy headers for IP detection (default: true)
# Set to false if not behind a reverse proxy
SECURITY_TRUST_PROXY=true

# Log rate limit violations (default: true)
SECURITY_LOG_VIOLATIONS=true

# Log suspicious patterns (scraping, enumeration) (default: true)
SECURITY_LOG_SUSPICIOUS=true
