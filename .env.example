# GitHub API Token (Required for production)
# Without this token, the GitHub API is limited to 60 requests/hour
# With authentication, you get 5000 requests/hour
# Create a token at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only access to public repositories)
GITHUB_TOKEN=your_github_personal_access_token_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
